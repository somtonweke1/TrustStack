# TrustStack Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/truststack

# Stripe Configuration
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Security Configuration
BCRYPT_ROUNDS=12

# Optional: External Services
# SENDGRID_API_KEY=sg_... # For email notifications
# TWILIO_ACCOUNT_SID=AC... # For SMS notifications
# TWILIO_AUTH_TOKEN=... # For SMS notifications

# Optional: Compliance Services
# ID_VERIFICATION_API_KEY=... # For KYC verification
# AML_CHECK_API_KEY=... # For anti-money laundering checks
